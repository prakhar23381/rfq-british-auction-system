{
  "name": "british-auction-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gen:api": "npx -y -p openapi-typescript@7 -p typescript@5 openapi-typescript ${OPENAPI_URL:-http://localhost:8000/openapi.json} -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
