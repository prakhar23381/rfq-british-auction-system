# Copy to backend/.env (make env does this) and adjust if needed.
DATABASE_URL=postgresql+psycopg://auction:auction@localhost:5432/british_auction
TEST_DATABASE_URL=postgresql+psycopg://auction:auction@localhost:5432/british_auction_test
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
CURRENCY=INR
LOG_LEVEL=INFO

# Celery Beat: seconds between lifecycle sweeps (safety net for missed start/close jobs)
LIFECYCLE_SWEEP_SECONDS=5
# Redis pub/sub channel carrying live events to every API process
EVENTS_CHANNEL=auction-events
